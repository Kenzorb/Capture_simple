# Copy to apps/web/.env.local for local configuration.
# Public web configuration
NEXT_PUBLIC_APP_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public extension identifiers, validated on the server
CAPTURE_EXTENSION_CLIENT_ID=
CAPTURE_EXTENSION_ID=

# Privileged server configuration
SUPABASE_SERVICE_ROLE_KEY=
# Set to 1 only in local development to use the Inngest Dev Server.
INNGEST_DEV=
# Optional development user UUID for automatic local dispatch.
INNGEST_DEV_OWNER_ID=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
OPENAI_API_KEY=
# Optional. Capture defaults to gpt-5.6-luna.
OPENAI_MODEL=
SENTRY_DSN=

# Stripe test values for the paid-readiness phase
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=
