{
  "name": "extension",
  "version": "0.1.0",
  "description": "Save articles to your Capture library.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt --browser chrome --mv3",
    "typecheck": "wxt prepare && tsc --noEmit",
    "build": "wxt build --browser chrome --mv3",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@capture/shared": "workspace:*",
    "@mozilla/readability": "0.6.0"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "wxt": "0.21.5"
  }
}
