{
  "name": "capture",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json && pnpm -r typecheck",
    "test": "vitest run",
    "test:browser": "playwright test",
    "build": "pnpm -r --if-present build"
  },
  "devDependencies": {
    "@capture/shared": "workspace:*",
    "@eslint/js": "^9.39.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^22.15.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "26.1.0",
    "prettier": "3.10.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vitest": "4.1.12"
  }
}
